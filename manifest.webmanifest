    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "生成貼文", "short_name": "生成", "description": "填簡報單，產出 FB／IG／Threads 貼文", "url": "./?source=shortcut#gen", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "貼文健檢", "short_name": "健檢", "description": "貼上現有貼文，即時 SEO／GEO 打分", "url": "./?source=shortcut#chk", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "寫法原則", "short_name": "原則", "description": "三平台 SEO／GEO 寫法重點", "url": "./?source=shortcut#how", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
